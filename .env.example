# Sizzle configuration - copy to `.env` (or export these in your shell).
# Nothing here is committed. `.env` is gitignored.
#
# This build renders ENTIRELY on your own NVIDIA GPU. There is no fal.ai key, no
# Cloudinary account, and no media hosting: your images and music never leave
# this machine. The ONLY optional outbound call is the Anthropic auto-prompt.
#
# Out of the box you need NO keys at all - just the downloaded weights.

# ----------------------------------------------------------------------------
# Render backend: local | mock
# ----------------------------------------------------------------------------
#   local -> run LTX-2.3 on this box's GPU (the default; needs the weights and
#            a CUDA card with ~40 GB+ of VRAM at default settings)
#   mock  -> no model at all. ffmpeg synthesizes each clip from the still image
#            so you can build/preview timelines and exercise the full pipeline
#            (continues, gap fill, mux) while the weights download.
SIZZLE_BACKEND=local

# ----------------------------------------------------------------------------
# Anthropic - OPTIONAL. Enables a vision model to write a per-image prompt and
# flag NSFW-leaning shots that platforms may age-gate. Without it, a generic
# reactive prompt is used and the app is 100% offline.
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=your-anthropic-key-here
# SIZZLE_AUTOPROMPT_MODEL=claude-opus-5     # or claude-haiku-4-5 for cheap/fast

# ----------------------------------------------------------------------------
# Where the weights live (scripts/download_models.py fills this)
# ----------------------------------------------------------------------------
# LTX_MODEL_ROOT=models
# GEMMA_PATH=models/gemma
# LTX_LORA_PATH=models/ltx2.3_audio_reactive_lora.safetensors
# SIZZLE_LORA_V2=1     # use the v2 audio-reactive LoRA (stronger beat impact)

# ----------------------------------------------------------------------------
# Quality / speed knobs
# ----------------------------------------------------------------------------
# SIZZLE_STEPS_DISTILLED=8      # distilled variant sampler steps
# SIZZLE_STEPS_FULL=20          # dev ("full quality") variant sampler steps
# SIZZLE_LORA_SCALE=1.2         # audio-reactive LoRA strength (1.2-1.5)
# How an image is mapped onto the frame when the aspect ratios differ:
#   contain (default) keep the WHOLE image, letterbox the rest - what the hosted
#                     build did, because fal fitted the picture server-side
#   cover             fill the frame and crop the overflow away (ltx's native
#                     behaviour; loses the edges of any mismatched image)
#   stretch           distort to fit
# SIZZLE_IMAGE_FIT=contain
# SIZZLE_IMAGE_FIT_BG=0,0,0     # letterbox colour for 'contain'
# SIZZLE_IMAGE_STRENGTH=0.62    # how tightly clip 1 is pinned to your image
# SIZZLE_A2V_GUIDANCE=3.0       # how hard the music steers the motion
# SIZZLE_NEGATIVE_PROMPT=

# ----------------------------------------------------------------------------
# GPU / memory
# ----------------------------------------------------------------------------
# Quantization: none | fp8-cast | fp8-scaled-mm | nvfp4-cast | nvfp4-prequant
#   none          bf16, best quality, needs the most VRAM (fine on 96 GB)
#   fp8-scaled-mm ~half the weight VRAM and FASTER on Blackwell
#   nvfp4-cast    smallest/fastest on Blackwell, lowest fidelity
# SIZZLE_QUANTIZATION=none
#
# Offloading, for cards that cannot hold the model: none | cpu | disk
# SIZZLE_OFFLOAD=none
#
# Cache checkpoint tensors in the loader registry between the two render
# stages. OFF by default and best left off: ltx_core keeps the cache on the
# BUILD device, so on CUDA this pins ~43 GB in VRAM on top of the model built
# from it (measured: 96.5 of 97.9 GB resident, and much slower). The OS page
# cache already keeps the file in spare RAM, which is the win you actually want.
# SIZZLE_CACHE_WEIGHTS=0
#
# Build the pipeline at server startup instead of on the first Generate.
# SIZZLE_WARMUP=1

# ----------------------------------------------------------------------------
# Output
# ----------------------------------------------------------------------------
# Width/height MUST be multiples of 64 (the two-stage pipeline renders at half
# size then upscales 2x). Custom sizes in the UI snap to that grid automatically.
# SIZZLE_WIDTH=1280
# SIZZLE_HEIGHT=704
# SIZZLE_MAX_FRAMES=457    # 19.04s @ 24fps; must be 8n+1
# SIZZLE_NVENC=1           # NVENC h264 for the final mux (falls back to x264)

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
# SIZZLE_HOST=127.0.0.1
# SIZZLE_PORT=8000
# SIZZLE_CA_BUNDLE=certs/ca-bundle.pem   # only behind a TLS-inspecting proxy
